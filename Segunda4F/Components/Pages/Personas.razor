@page "/personas"
@using System.Threading.Tasks
@using System.Text
@using System.Globalization
@inject IJSRuntime JS
@rendermode InteractiveServer
@inject IRepositorioPersonas _repositorioPersonas
@inject NavigationManager _navigationManager
<h3>Personas</h3>
<button class="btn btn-primary mb-3" @onclick="@(() => _navigationManager.NavigateTo("/personas/nueva"))">Nueva Persona</button>
<button class="btn btn-primary mb-3" @onclick="ExportCsv">Exportar CSV</button>

<QuickGrid Items="_personas.AsQueryable()" Class="table table-striped" Pagination="_paginationState">
    <PropertyColumn Property="@(p => p.Nombre)" Title="Nombre" Sortable="true" />
    <PropertyColumn Property="@(p => p.Telefono)" Title="Teléfono" />
    <PropertyColumn Property="@(p => p.Correo)" Title="Correo" />
    <PropertyColumn Property="@(p => p.Genero)" Title="Género" Sortable="true" />
    <PropertyColumn Property="@(p => p.Clasificacion!.Nombre)" Title="Clasificación" Sortable="true" />
    
    <TemplateColumn Title="Hábitos">
        @if (context.Habitos != null && context.Habitos.Any())
        {
            foreach (var h in context.Habitos)
            {
                <span class="badge bg-secondary me-1">@h.Nombre</span>
            }
        }
        else
        {
            <span class="text-muted">—</span>
        }
    </TemplateColumn>

    <TemplateColumn Title="Actions">
        <button class="btn btn-outline-primary" @onclick="@(() => Edit(context))">Editar</button>
        <button class="btn btn-outline-danger" @onclick="@(() => Delete(context))">Eliminar</button>
    </TemplateColumn>
</QuickGrid>
<Paginator State="_paginationState" />

