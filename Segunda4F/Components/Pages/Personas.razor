    private void Edit(Persona persona)
    {
        _navigationManager.NavigateTo($"/personas/editar/{persona.Id}");
    }

    private async Task Delete(Persona persona)
    {
        if (persona != null)
        {
            await _repositorioPersonas.EliminarPersona(persona.Id);
            _personas.Remove(persona);
