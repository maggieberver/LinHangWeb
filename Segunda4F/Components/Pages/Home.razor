@page "/"

<PageTitle>Inicio</PageTitle>

<section class="home-page">

    <div class="hero-img"></div>

    <div class="address-text">
        <i class="bi bi-geo-alt-fill"></i>
        Av. Amor y Paz #224, Col. Rinconcinto en el Cielo C.P. 28017, Colima, Colima.
    </div>

    <div class="home-actions">
        <div>
            <h1>ORDENA EN LÍNEA</h1>
            <p>RECOGE EN TIENDA O TE LO ENVIAMOS A DOMICILIO</p>
        </div>

        <img src="/images/moto.png" class="moto-img" />

        <div class="buttons">
            <a href="/pedido" class="btn btn-danger btn-lg rounded-pill px-4">
                REALIZAR PEDIDO
            </a>

            <a href="/pedidos" class="btn btn-danger btn-lg rounded-pill px-4">
                VER PEDIDOS
            </a>
        </div>
    </div>

</section>

<style>
    .home-page {
        width: 100%;
        height: calc(100vh - 98px);
        overflow: hidden;
        color: white;
        background: radial-gradient(circle at 50% 50%, #3f3f3f, #242424, #000000);
        display: grid;
        grid-template-rows: 52vh auto 1fr;
    }

    .hero-img {
        width: 100%;
        height: 100%;
        background-image: url('/images/restaurante.jpg');
        background-size: cover;
        background-position: center;
    }

    .address-text {
        text-align: center;
        padding: 10px;
        font-weight: bold;
    }

    .home-actions {
        display: flex;
        align-items: center;
        justify-content: space-around;
        gap: 25px;
        padding: 25px 60px;
    }

        .home-actions h1 {
            font-weight: 900;
            font-style: italic;
            font-size: 3.3rem;
        }

        .home-actions p {
            font-style: italic;
            font-weight: 600;
            font-size: 1rem;
        }

    .moto-img {
        width: 145px;
        height: auto;
    }

    .buttons {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
    }

    .btn-danger {
        background: #b10000;
        border: none;
        font-weight: bold;
    }

        .btn-danger:hover {
            background: #7a0000;
        }

    @@media (max-width: 768px) {
        .home-page {
            height: auto;
            min-height: calc(100vh - 98px);
            overflow: auto;
            grid-template-rows: 38vh auto auto;
        }

        .home-actions {
            flex-direction: column;
            text-align: center;
            padding: 25px 20px;
        }

            .home-actions h1 {
                font-size: 2.4rem;
            }

        .moto-img {
            width: 110px;
        }
    }
</style>