@page "/clasificaciones/nueva"
@page "/clasificaciones/editar/{Id:int}"
@rendermode InteractiveServer
@inject IRepositorioClasificaciones _repositorioClasificaciones
@inject NavigationManager _navigationManager
<PageTitle>Clasificaciones</PageTitle>
<h3>Clasificaciones</h3>
@if (_error)
{
    <div class="alert alert-danger"><h2>No se encontró la persona.</h2></div>
}
else
{

    <EditForm Model="_clasificacion" FormName="frmClasificacion" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row mb-3 align-items-center">
            <div class="col-2">
                <label for="txtNombre" class="col-form-label">Nombre</label>
            </div>
            <div class="col-10">
                <InputText class="form-control" id="txtNombre" @bind-Value="_clasificacion.Nombre" />
                <ValidationMessage For="@(() => _clasificacion.Nombre)" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="@(() => _navigationManager.NavigateTo("/clasificaciones"))">Cancelar</button>
    </EditForm>
}
@code {
    [Parameter]
    public int? Id { get; set; }
    private Clasificacion? _clasificacion = new Clasificacion();
    private bool _error = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue && Id.Value > 0)
        {
            var p = await _repositorioClasificaciones.ObtenerClasificacionPorId(Id.Value);
            if (p == null)
            {
                _error = true;
                _clasificacion = new Clasificacion();
            }
            else
            {
                _clasificacion = p;
            }
        }
        else
        {
            // Nuevo registro: asegurar instancia no nula
            _clasificacion ??= new Clasificacion();
        }
    }

    private async Task Guardar()
    {
        if (_clasificacion == null) return;

        if (Id.HasValue && Id.Value > 0)
        {
            await _repositorioClasificaciones.ActualizarClasificacion(_clasificacion);
        }
        else
        {
            await _repositorioClasificaciones.AgregarClasificacion(_clasificacion);
        }
        _navigationManager.NavigateTo("/clasificaciones");
    }
}
